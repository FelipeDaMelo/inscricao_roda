# ==========================================
# FIREBASE CLIENT SDK (variáveis públicas)
# ==========================================
# Encontre esses valores em:
# Firebase Console > Configurações do Projeto > Geral > Seus apps > Web
NEXT_PUBLIC_FIREBASE_API_KEY=sua-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ==========================================
# FIREBASE ADMIN SDK (variáveis privadas)
# ==========================================
# Encontre esses valores no arquivo JSON baixado em:
# Firebase Console > Configurações > Contas de serviço > Gerar nova chave privada
FIREBASE_ADMIN_PROJECT_ID=seu-projeto-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
